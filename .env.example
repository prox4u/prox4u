# Proxmox VE
PVE_URL=https://192.168.1.80:8006
PVE_USER=supervision@pam
PVE_TOKEN_ID=A1234567890B
PVE_TOKEN_VALUE=CHANGE_ME
# true = accepter le certificat auto-signé Proxmox (recommandé)
TLS_REJECT_UNAUTHORIZED=false

# Mode mock : 1 = données simulées (démo multi-bâtiments), 0 = cluster réel
MOCK=0
# Scénario mock : nominal | degraded | critical
MOCK_SCENARIO=nominal

# Serveur
PORT=8080

# InfluxDB 3 Core (optionnel : si INFLUX_TOKEN vide, repli RRD Proxmox)
# Générer le token avec : ./deploiement/50-influxdb-init.sh && docker compose up -d influxdb
INFLUX_URL=https://localhost:8181
INFLUX_TOKEN=CHANGE_ME
INFLUX_RAW_DB=raw
INFLUX_AGG_DB=consolidated
# Base RRD native Proxmox VE (7 tables). Déjà présente chez les clients existants →
# pointer dessus pour s'y connecter. Défaut : proxmox.
INFLUX_RRD_DB=proxmox
# User non-root du conteneur : data/influxdb/ doit être chown'ée à ce uid/gid
INFLUX_UID=1500
INFLUX_GID=1500
# IP du serveur dans le réseau interne, pour exposer l'API InfluxDB aux agents
# Telegraf des nœuds Proxmox (écriture depuis les nœuds). Vide = rien n'est
# exposé au réseau (l'app locale passe par 127.0.0.1). Ex. INFLUX_LAN_BIND=192.168.1.10
INFLUX_LAN_BIND=

# TLS (générer les certificats avec : ./deploiement/40-tls-init.sh)
# Application : si vides, HTTP clair sur PORT
TLS_KEY=data/tls/app-key.pem
TLS_CERT=data/tls/app-cert.pem
# Certificat auto-signé InfluxDB à faire confiance (fetch app → InfluxDB)
INFLUX_CA_CERT=data/tls/influxdb-cert.pem

# Explorer (UI InfluxDB 3, port 8888) — clé de session : openssl rand -hex 32
EXPLORER_SESSION_KEY=CHANGE_ME
